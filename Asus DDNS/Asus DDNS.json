    {
        "id": "1a5f12878de98534",
        "type": "function",
        "z": "c1403ba892a9e87f",
        "name": "Asus DDNS username/password calc",
        "func": "// I:\n// msg.payload.Action - register/update\n// msg.payload.WANIP - current WAN IP\n// msg.payload.Name - which name[.asuscomm.com] to use\n// msg.payload.MAC - MAC of ETH\n// msg.payload.PIN - PIN from label\n\n\n// strip ':' from MAC and '.' from IP\nvar sMAC = msg.payload.MAC.replace(/:/g, ''); msg.payload.MAC = sMAC;\nvar sWANIP = msg.payload.WANIP.replace(/\\./g, '');\nvar sData = msg.payload.Name + \"asuscommcom\" + sWANIP\n//msg.payload.Name = msg.payload.Name + \".asuscomm.com\"\n//return msg\n\n// Calculate the password as hostname+WANIP hashed by PIN\nvar oHMAC = crypto.createHmac('md5', msg.payload.PIN); //creating hmac object\nvar oData = oHMAC.update(sData); //passing the data to be hashed\n//Creating the hmac in the required format\nvar sHMAC = oData.digest('hex'); sHMAC = sHMAC.toUpperCase();\nmsg.payload.HMAC = sHMAC;\nmsg.payload.Data = sData;\n\n// prepare data for http request node\nvar newmsg = {}; newmsg.payload = {};\nnewmsg.method = \"GET\"\nnewmsg.url = \"http://\" + sMAC + \":\" + sHMAC + \"@ns1.asuscomm.com/ddns/\" + msg.payload.Action + \".jsp?hostname=\" + msg.payload.Name + \".asuscomm.com&myip=\" + msg.payload.WANIP;\n\nreturn newmsg",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [
            {
                "var": "crypto",
                "module": "crypto"
            }
        ],
        "x": 370,
        "y": 280,
        "wires": [
            [
                "43486b07f55af7c5"
            ]
        ]
    },
