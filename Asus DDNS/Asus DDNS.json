    {
        "id": "7f14821f4c24fd9b",
        "type": "function",
        "z": "c1403ba892a9e87f",
        "name": "Asus DDNS status result",
        "func": "\n// translate return codes tu human readable form\nvar sAction = \"\"\nif (msg.responseUrl.includes(\"update.jsp\") === true)\n    sAction = \"Update\";\nelse\n    sAction = \"Registration\";\n\nvar newmsg = {};\nnewmsg.statusCode = msg.statusCode\nswitch (msg.statusCode)\n    {\n    case 200: newmsg.payload = sAction + \" success\";break;\n    case 203:\n    case 233: newmsg.payload = sAction + \" failed\"; break;\n    case 220: newmsg.payload = sAction + \" same domain success\"; break;\n    case 230: newmsg.payload = sAction + \" new domain success\"; break;\n    case 297: newmsg.payload = \"Invalid hostname\"; break;\n    case 298: newmsg.payload = \"Invalid domain name\"; break;\n    case 299: newmsg.payload = \"Invalid IP format\"; break;\n    case 401: newmsg.payload = \"Authentication failure\"; break;\n    case 407: newmsg.payload = \"Proxy authentication Required\"; break;\n    \n    default:\n        newmsg.payload = \"Unknown result code \" + msg.statusCode; break;\n    }\n\nreturn newmsg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 400,
        "wires": [
            []
        ]
    },
